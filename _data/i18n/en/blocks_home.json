    "nome": "Contatti",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec gc-dark\" id=\"contatti\"><div class=\"gc-wrap\"><h2 class=\"gc-h2\">Got a request?</h2><p class=\"gc-lead\">Write to us: we reply as soon as we can.</p><a class=\"gc-btn\" href=\"__BASEURL__/en/contact/\">Contact us</a></div></section></div>"
  }
