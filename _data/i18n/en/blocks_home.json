    "enabled": true,
    "html": "<style>\n.cu-hero{background:#fff!important}\n.cu-hero::before{display:none}\n.cu-hero .gc-hero-in{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr)}\n.cu-hero-img{display:block;width:100%;height:auto;max-height:calc(100svh - 80px - 3rem);object-fit:contain;margin:0 auto}\n.cu-cuc{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1.1rem;margin-top:2rem}\n.cu-c{display:flex;flex-direction:column;text-decoration:none!important;color:var(--gc-ink,#0e1116);border:1px solid var(--gc-line,#e6e8ee);border-radius:14px;overflow:hidden;background:#fff;transition:border-color .2s,box-shadow .2s}\n.cu-c:hover,.cu-c:focus-visible{border-color:var(--gc-acc);box-shadow:0 0 0 1px var(--gc-acc)}\n.cu-c img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#fff}\n.cu-c b{padding:.8rem 1rem;font-size:1.02rem;line-height:1.25}\n@media(max-width:900px){.cu-hero-img{max-height:none}}\n</style><div class=\"gc\"><section class=\"ent-hero cu-hero\"><div class=\"gc-wrap gc-hero-in\"><div><h1 class=\"gc-h1\">From our kitchen to your door.</h1><p class=\"gc-lead\">Ten kitchens, one order: pizza, flatbreads, baked pasta, burgers, chicken, fried snacks, Asian, kebab, lunch and bowls.</p><div class=\"gc-act\"><a class=\"gc-btn gc-btn-a\" href=\"__BASEURL__/en/shop/\">Order now</a><a class=\"gc-btn gc-btn-o\" href=\"#cucine\">Pick a kitchen</a></div></div><img class=\"cu-hero-img\" src=\"__BASEURL__/assets/images/hero-casa.webp\" width=\"1024\" height=\"1024\" alt=\"All our kitchens: pizza, flatbreads, lasagne, burgers, chicken, fried snacks, gyoza, kebab, salads and poke\" fetchpriority=\"high\"></div></section></div>"
  },
  {
    "id": "cucine",
    "nome": "Cucine",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec\" id=\"cucine\"><div class=\"gc-wrap\"><h2 class=\"gc-h2\">Pick your kitchen</h2><p class=\"gc-lead\">Each kitchen has its own menu: open the one you feel like today.</p><div class=\"cu-cuc\"><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/pizza/\"><img src=\"__BASEURL__/assets/images/prodotti/pizza-margherita.webp\" alt=\"\" loading=\"lazy\"><b>Pizza</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/piadine-wrap/\"><img src=\"__BASEURL__/assets/images/prodotti/piadina-crudo-e-squacquerone.webp\" alt=\"\" loading=\"lazy\"><b>Flatbreads and wraps</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/primi-forno/\"><img src=\"__BASEURL__/assets/images/prodotti/lasagne-alla-bolognese.webp\" alt=\"\" loading=\"lazy\"><b>Oven-baked pasta</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/hamburger/\"><img src=\"__BASEURL__/assets/images/prodotti/hamburger-classico.webp\" alt=\"\" loading=\"lazy\"><b>Burgers</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/pollo-rosticceria/\"><img src=\"__BASEURL__/assets/images/prodotti/pollo-arrosto-intero.webp\" alt=\"\" loading=\"lazy\"><b>Roast chicken and deli</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/fritti/\"><img src=\"__BASEURL__/assets/images/prodotti/arancini-siciliani.webp\" alt=\"\" loading=\"lazy\"><b>Fried snacks and street food</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/asiatico/\"><img src=\"__BASEURL__/assets/images/prodotti/gyoza-di-maiale-6-pz.webp\" alt=\"\" loading=\"lazy\"><b>Asian kitchen</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/kebab/\"><img src=\"__BASEURL__/assets/images/prodotti/kebab-nel-panino.webp\" alt=\"\" loading=\"lazy\"><b>Kebab</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/pranzo-ufficio/\"><img src=\"__BASEURL__/assets/images/prodotti/menu-ufficio.webp\" alt=\"\" loading=\"lazy\"><b>Office lunch</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/bowl-poke/\"><img src=\"__BASEURL__/assets/images/prodotti/poke-al-salmone.webp\" alt=\"\" loading=\"lazy\"><b>Bowls and poke</b></a></div></div></section></div>"
