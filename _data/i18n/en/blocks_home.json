  {
    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<style>\n.cu-hero{background:linear-gradient(90deg,rgba(11,79,99,.93) 0%,rgba(11,79,99,.8) 42%,rgba(11,79,99,.3) 100%),url(__BASEURL__/assets/images/hero-bg.webp) center/cover no-repeat,linear-gradient(135deg,#168aad,#0b4f63)!important}\n.cu-hero::before{display:none}\n.cu-hero .gc-hero-in{grid-template-columns:minmax(0,40rem)}\n.gc .cu-hero .gc-h1,.gc .cu-hero .gc-lead,.gc .cu-hero .cu-msg{color:#fff}\n.gc .cu-hero .cu-msg{font-weight:500;font-size:.95rem;opacity:.92}\n.gc .cu-hero .gc-act{display:flex;gap:.7rem;flex-wrap:wrap}\n.gc .cu-hero .gc-btn{background:#fff;color:#0b4f63;border:2px solid #fff}\n.gc .cu-hero .gc-btn.cu-sec{background:transparent;color:#fff;border-color:rgba(255,255,255,.75)}\n.gc .cu-hero .gc-btn:focus-visible{outline:3px solid #ffd166;outline-offset:2px}\n.cu-cap{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin:1rem 0 .4rem}\n.cu-cap label{flex:1 0 100%;font-weight:600}\n.cu-cap input{flex:0 1 11rem;font:inherit;font-size:1.15rem;letter-spacing:.12em;padding:.7rem 1rem;border:1px solid var(--gc-line,#cfd3da);border-radius:10px;background:#fff;color:var(--gc-ink,#0e1116)}\n.cu-cap input:focus-visible{outline:3px solid var(--gc-acc);outline-offset:2px}\n.cu-msg{margin:0 0 .8rem;font-weight:600;color:var(--gc-mut,#56606b)}\n.cu-ok{color:#1a7f37}.cu-no{color:#b42318}\n.cu-cuc{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1.1rem;margin-top:2rem}\n.cu-lock .cu-cuc{opacity:.4;pointer-events:none;filter:grayscale(.6)}\n.cu-lockmsg{display:none;font-weight:600;color:var(--gc-acc)}.cu-lock .cu-lockmsg{display:block}\n.cu-c{display:flex;flex-direction:column;text-decoration:none!important;color:var(--gc-ink,#0e1116);border:1px solid var(--gc-line,#e6e8ee);border-radius:14px;overflow:hidden;background:#fff;transition:border-color .2s,box-shadow .2s}\n.cu-c:hover,.cu-c:focus-visible{border-color:var(--gc-acc);box-shadow:0 0 0 1px var(--gc-acc)}\n.cu-c img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#fff}\n.cu-c b{padding:.8rem 1rem;font-size:1.02rem;line-height:1.25}\n@media(max-width:900px){.cu-hero{background:linear-gradient(180deg,rgba(11,79,99,0) 0,rgba(11,79,99,0) calc(min(56vw,17rem)*.5),#0b4f63 min(56vw,17rem)) 0 0/100% min(56vw,17rem) no-repeat,url(__BASEURL__/assets/images/hero-bg.webp) 72% 0/auto min(56vw,17rem) no-repeat,#0b4f63!important}.gc .cu-hero{padding-top:calc(min(56vw,17rem) + 1rem)}.cu-hero .gc-hero-in{grid-template-columns:minmax(0,1fr)}.gc .cu-hero .gc-h1{font-size:clamp(1.75rem,7.4vw,2.3rem);line-height:1.12}.gc .cu-hero .gc-lead{font-size:1.05rem}.gc .cu-hero .gc-act .gc-btn{flex:1 1 100%;text-align:center}}\n</style><div class=\"gc\"><section class=\"ent-hero cu-hero\"><div class=\"gc-wrap gc-hero-in\"><div><h1 class=\"gc-h1\">Takeaway kitchens in Monterotondo, Mentana and Fonte Nuova.</h1><p class=\"gc-lead\">Twelve separate kitchens, each with its own menu.</p><p class=\"cu-msg\">We deliver to Mentana, Tor Lupara, Fonte Nuova and Santa Lucia (00013), Monterotondo and Monterotondo Scalo (00015).</p><div class=\"gc-act\"><a class=\"gc-btn gc-btn-o\" href=\"#cucine\">See the kitchens</a></div></div></div></section></div>"
  },
  {
    "id": "cucine",
    "nome": "Cucine",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec\" id=\"cucine\"><div class=\"gc-wrap\"><h2 class=\"gc-h2\">Twelve kitchens, twelve menus</h2><p class=\"gc-lead\">Each kitchen prepares only its own menu and is ordered separately.</p><div class=\"cu-cuc\"><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/pizza/\"><img src=\"__BASEURL__/assets/images/prodotti/pizza-margherita.webp\" alt=\"\" loading=\"lazy\"><b>Pizza</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/piadine-wrap/\"><img src=\"__BASEURL__/assets/images/prodotti/piadina-crudo-e-squacquerone.webp\" alt=\"\" loading=\"lazy\"><b>Flatbreads and wraps</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/primi-forno/\"><img src=\"__BASEURL__/assets/images/prodotti/lasagne-alla-bolognese.webp\" alt=\"\" loading=\"lazy\"><b>Oven-baked pasta</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/hamburger/\"><img src=\"__BASEURL__/assets/images/prodotti/hamburger-classico.webp\" alt=\"\" loading=\"lazy\"><b>Burgers</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/pollo-rosticceria/\"><img src=\"__BASEURL__/assets/images/prodotti/pollo-arrosto-intero.webp\" alt=\"\" loading=\"lazy\"><b>Roast chicken and deli</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/fritti/\"><img src=\"__BASEURL__/assets/images/prodotti/arancini-siciliani.webp\" alt=\"\" loading=\"lazy\"><b>Fried snacks and street food</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/asiatico/\"><img src=\"__BASEURL__/assets/images/prodotti/gyoza-di-maiale-6-pz.webp\" alt=\"\" loading=\"lazy\"><b>Asian kitchen</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/kebab/\"><img src=\"__BASEURL__/assets/images/prodotti/kebab-nel-panino.webp\" alt=\"\" loading=\"lazy\"><b>Kebab</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/pranzo-ufficio/\"><img src=\"__BASEURL__/assets/images/prodotti/menu-ufficio.webp\" alt=\"\" loading=\"lazy\"><b>Work lunch</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/bowl-poke/\"><img src=\"__BASEURL__/assets/images/prodotti/poke-al-salmone.webp\" alt=\"\" loading=\"lazy\"><b>Bowls and poke</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/fresh-pasta/\"><img src=\"__BASEURL__/assets/images/prodotti/ravioli-ricotta-e-spinaci.webp\" alt=\"\" loading=\"lazy\"><b>Fresh pasta</b></a><a class=\"cu-c\" href=\"__BASEURL__/en/shop/category/desserts/\"><img src=\"__BASEURL__/assets/images/prodotti/tiramisu-monoporzione.webp\" alt=\"\" loading=\"lazy\"><b>Desserts</b></a></div></div></section></div>"
