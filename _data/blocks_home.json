    "html": "<style>\n.cu-hero{background:#fff!important}\n.cu-hero::before{display:none}\n.cu-hero .gc-hero-in{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr)}\n.cu-hero-img{display:block;width:100%;height:auto;max-height:calc(100svh - 80px - 3rem);object-fit:contain;margin:0 auto}\n.cu-cuc{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1.1rem;margin-top:2rem}\n.cu-c{display:flex;flex-direction:column;text-decoration:none!important;color:var(--gc-ink,#0e1116);border:1px solid var(--gc-line,#e6e8ee);border-radius:14px;overflow:hidden;background:#fff;transition:border-color .2s,box-shadow .2s}\n.cu-c:hover,.cu-c:focus-visible{border-color:var(--gc-acc);box-shadow:0 0 0 1px var(--gc-acc)}\n.cu-c img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#fff}\n.cu-c b{padding:.8rem 1rem;font-size:1.02rem;line-height:1.25}\n@media(max-width:900px){.cu-hero-img{max-height:none}}\n</style><div class=\"gc\"><section class=\"ent-hero cu-hero\"><div class=\"gc-wrap gc-hero-in\"><div><h1 class=\"gc-h1\">Dalla nostra cucina a casa tua.</h1><p class=\"gc-lead\">Dieci cucine, un solo ordine: pizza, piadine, primi, hamburger, pollo, fritti, asiatico, kebab, pranzo e bowl.</p><div class=\"gc-act\"><a class=\"gc-btn gc-btn-a\" href=\"__BASEURL__/negozio/\">Ordina ora</a><a class=\"gc-btn gc-btn-o\" href=\"#cucine\">Scegli la cucina</a></div></div><img class=\"cu-hero-img\" src=\"__BASEURL__/assets/images/hero-casa.webp\" width=\"1024\" height=\"1024\" alt=\"Tutte le nostre cucine: pizza, piadine, lasagne, hamburger, pollo, fritti, gyoza, kebab, insalate e poke\" fetchpriority=\"high\"></div></section></div>"
