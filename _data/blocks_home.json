  {
    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<style>\n.cu-hero{background:#fff!important}\n.cu-hero::before{display:none}\n.cu-hero .gc-hero-in{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr)}\n.cu-hero-img{display:block;width:100%;height:auto;max-height:calc(100svh - 80px - 3rem);object-fit:contain;margin:0 auto}\n.cu-cap{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin:1rem 0 .4rem}\n.cu-cap label{flex:1 0 100%;font-weight:600}\n.cu-cap input{flex:0 1 11rem;font:inherit;font-size:1.15rem;letter-spacing:.12em;padding:.7rem 1rem;border:1px solid var(--gc-line,#cfd3da);border-radius:10px;background:#fff;color:var(--gc-ink,#0e1116)}\n.cu-cap input:focus-visible{outline:3px solid var(--gc-acc);outline-offset:2px}\n.cu-msg{margin:0 0 .8rem;font-weight:600;color:var(--gc-mut,#56606b)}\n.cu-ok{color:#1a7f37}.cu-no{color:#b42318}\n.cu-cuc{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1.1rem;margin-top:2rem}\n.cu-lock .cu-cuc{opacity:.4;pointer-events:none;filter:grayscale(.6)}\n.cu-lockmsg{display:none;font-weight:600;color:var(--gc-acc)}.cu-lock .cu-lockmsg{display:block}\n.cu-c{display:flex;flex-direction:column;text-decoration:none!important;color:var(--gc-ink,#0e1116);border:1px solid var(--gc-line,#e6e8ee);border-radius:14px;overflow:hidden;background:#fff;transition:border-color .2s,box-shadow .2s}\n.cu-c:hover,.cu-c:focus-visible{border-color:var(--gc-acc);box-shadow:0 0 0 1px var(--gc-acc)}\n.cu-c img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#fff}\n.cu-c b{padding:.8rem 1rem;font-size:1.02rem;line-height:1.25}\n@media(max-width:900px){.cu-hero-img{max-height:none}}\n</style><div class=\"gc\"><section class=\"ent-hero cu-hero\"><div class=\"gc-wrap gc-hero-in\"><div><h1 class=\"gc-h1\">Cucina da asporto a Monterotondo, Mentana e Fonte Nuova.</h1><p class=\"gc-lead\">Dieci cucine separate, ognuna con il suo menu. Inserisci il CAP per vedere se consegniamo da te.</p><form class=\"cu-cap\" id=\"cu-cap\" data-ok=\"Consegniamo a {c}. Scegli la cucina.\" data-no=\"Non consegniamo in questo CAP. Consegniamo a Monterotondo (00015), Mentana e Fonte Nuova (00013).\"><input aria-label=\"Il tuo CAP\" id=\"cu-cap-in\" inputmode=\"numeric\" pattern=\"[0-9]{5}\" maxlength=\"5\" autocomplete=\"postal-code\" placeholder=\"00015\" required><button class=\"gc-btn gc-btn-a\" type=\"submit\">Verifica</button></form><p class=\"cu-msg\" id=\"cu-cap-msg\" role=\"status\" aria-live=\"polite\">Consegniamo ai CAP 00013 e 00015.</p><div class=\"gc-act\"><a class=\"gc-btn gc-btn-o\" href=\"#cucine\">Vedi le cucine</a></div></div><img class=\"cu-hero-img\" src=\"__BASEURL__/assets/images/hero-casa.webp\" width=\"1024\" height=\"1024\" alt=\"Tutte le nostre cucine: pizza, piadine, lasagne, hamburger, pollo, fritti, gyoza, kebab, insalate e poke\" fetchpriority=\"high\"></div></section></div>"
  },
  {
    "id": "cucine",
    "nome": "Cucine",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec\" id=\"cucine\"><div class=\"gc-wrap\"><h2 class=\"gc-h2\">Dieci cucine, dieci menu</h2><p class=\"gc-lead\">Ogni cucina prepara solo il suo menu e si ordina a parte.</p><p class=\"cu-lockmsg\">Inserisci il CAP in alto per ordinare.</p><div class=\"cu-cuc\"><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/pizza/\"><img src=\"__BASEURL__/assets/images/prodotti/pizza-margherita.webp\" alt=\"\" loading=\"lazy\"><b>Pizza</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/piadine-wrap/\"><img src=\"__BASEURL__/assets/images/prodotti/piadina-crudo-e-squacquerone.webp\" alt=\"\" loading=\"lazy\"><b>Piadine e wrap</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/primi-forno/\"><img src=\"__BASEURL__/assets/images/prodotti/lasagne-alla-bolognese.webp\" alt=\"\" loading=\"lazy\"><b>Primi da forno</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/hamburger/\"><img src=\"__BASEURL__/assets/images/prodotti/hamburger-classico.webp\" alt=\"\" loading=\"lazy\"><b>Hamburger</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/pollo-rosticceria/\"><img src=\"__BASEURL__/assets/images/prodotti/pollo-arrosto-intero.webp\" alt=\"\" loading=\"lazy\"><b>Pollo e rosticceria</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/fritti/\"><img src=\"__BASEURL__/assets/images/prodotti/arancini-siciliani.webp\" alt=\"\" loading=\"lazy\"><b>Fritti e street food</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/asiatico/\"><img src=\"__BASEURL__/assets/images/prodotti/gyoza-di-maiale-6-pz.webp\" alt=\"\" loading=\"lazy\"><b>Cucina asiatica</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/kebab/\"><img src=\"__BASEURL__/assets/images/prodotti/kebab-nel-panino.webp\" alt=\"\" loading=\"lazy\"><b>Kebab</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/pranzo-ufficio/\"><img src=\"__BASEURL__/assets/images/prodotti/menu-ufficio.webp\" alt=\"\" loading=\"lazy\"><b>Pranzo da ufficio</b></a><a class=\"cu-c\" href=\"__BASEURL__/negozio/categoria/bowl-poke/\"><img src=\"__BASEURL__/assets/images/prodotti/poke-al-salmone.webp\" alt=\"\" loading=\"lazy\"><b>Bowl e poke</b></a></div></div></section></div><script>(function(){var f=document.getElementById('cu-cap'),i=document.getElementById('cu-cap-in'),m=document.getElementById('cu-cap-msg'),g=document.getElementById('cucine');var Z={'00015':'Monterotondo','00013':'Mentana, Fonte Nuova'};\nfunction lock(on){g.classList.toggle('cu-lock',on)}\nfunction ok(c){m.className='cu-msg cu-ok';m.textContent=f.dataset.ok.replace('{c}',Z[c]);lock(false)}\ntry{var s=localStorage.getItem('cu_cap');if(s&&Z[s]){i.value=s;ok(s)}else lock(true)}catch(e){lock(true)}\nf.addEventListener('submit',function(e){e.preventDefault();var c=i.value.trim();if(Z[c]){ok(c);try{localStorage.setItem('cu_cap',c)}catch(x){}g.scrollIntoView()}else{m.className='cu-msg cu-no';m.textContent=f.dataset.no;lock(true)}})})();</script>"
  },
