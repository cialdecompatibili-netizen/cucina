    "html": "<style>\n.cu-hero{background:#fff!important}\n.cu-hero::before{display:none}\n.cu-hero .gc-hero-in{grid-template-columns:minmax(0,1fr) minmax(0,1.1fr)}\n.cu-hero-img{display:block;width:100%;height:auto;max-height:calc(100svh - 80px - 3rem);object-fit:contain;margin:0 auto}\n.cu-cap{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin:1rem 0 .4rem}\n.cu-cap label{flex:1 0 100%;font-weight:600}\n.cu-cap input{flex:0 1 11rem;font:inherit;font-size:1.15rem;letter-spacing:.12em;padding:.7rem 1rem;border:1px solid var(--gc-line,#cfd3da);border-radius:10px;background:#fff;color:var(--gc-ink,#0e1116)}\n.cu-cap input:focus-visible{outline:3px solid var(--gc-acc);outline-offset:2px}\n.cu-msg{margin:0 0 .8rem;font-weight:600;color:var(--gc-mut,#56606b)}\n.cu-ok{color:#1a7f37}.cu-no{color:#b42318}\n.cu-cuc{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1.1rem;margin-top:2rem}\n.cu-lock .cu-cuc{opacity:.4;pointer-events:none;filter:grayscale(.6)}\n.cu-lockmsg{display:none;font-weight:600;color:var(--gc-acc)}.cu-lock .cu-lockmsg{display:block}\n.cu-c{display:flex;flex-direction:column;text-decoration:none!important;color:var(--gc-ink,#0e1116);border:1px solid var(--gc-line,#e6e8ee);border-radius:14px;overflow:hidden;background:#fff;transition:border-color .2s,box-shadow .2s}\n.cu-c:hover,.cu-c:focus-visible{border-color:var(--gc-acc);box-shadow:0 0 0 1px var(--gc-acc)}\n.cu-c img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#fff}\n.cu-c b{padding:.8rem 1rem;font-size:1.02rem;line-height:1.25}\n@media(max-width:900px){.cu-hero-img{max-height:none}}\n</style><div class=\"gc\"><section class=\"ent-hero cu-hero\"><div class=\"gc-wrap gc-hero-in\"><div><h1 class=\"gc-h1\">Cucina da asporto a Monterotondo, Mentana e Fonte Nuova.</h1><p class=\"gc-lead\">Undici cucine separate, ognuna con il suo menu.</p><p class=\"cu-msg\">Consegniamo a Mentana, Tor Lupara, Fonte Nuova e Santa Lucia (00013), Monterotondo e Monterotondo Scalo (00015).</p><div class=\"gc-act\"><a class=\"gc-btn gc-btn-o\" href=\"#cucine\">Vedi le cucine</a></div></div><img class=\"cu-hero-img\" src=\"__BASEURL__/assets/images/hero-casa.webp\" width=\"1024\" height=\"1024\" alt=\"Tutte le nostre cucine: pizza, piadine, lasagne, hamburger, pollo, fritti, gyoza, kebab, insalate e poke\" fetchpriority=\"high\"></div></section></div>"
